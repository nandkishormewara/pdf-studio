{
  "info": {
    "name": "PDF Studio server API",
    "description": "PDF Studio processing server API. Maintained by hand. See docs/api-testing.md for setup, the sample files in test-kit/ and the expected results.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8787"
    }
  ],
  "item": [
    {
      "name": "API-01 Health (P1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('ok and version', () => { pm.expect(b.ok).to.be.true; pm.expect(b.version).to.eql('0.5.0'); });",
              "pm.test('features listed', () => ['convert','ocr','redact','sign','verify','optimize','extract'].forEach(f => pm.expect(b.features).to.have.property(f)));",
              "pm.test('English and Hindi OCR available', () => { pm.expect(b.ocrLanguages).to.include('eng'); pm.expect(b.ocrLanguages).to.include('hin'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "API-02 Convert HTML to PDF (P1)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "convert"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "test-kit/convert-test.html"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('PDF returned', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); pm.expect(pm.response.stream.slice(0, 5).toString()).to.eql('%PDF-'); });"
            ]
          }
        }
      ]
    },
