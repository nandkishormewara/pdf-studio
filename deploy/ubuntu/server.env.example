# /etc/pdf-studio/server.env — settings for the PDF Studio server. Readable by root and pdfstudio only.
# The web app calls the server through nginx on the same address, so CORS only matters for other origins.
PDFSTUDIO_ALLOWED_ORIGINS=https://SERVER_NAME
PDFSTUDIO_MAX_UPLOAD_MB=100
PDFSTUDIO_DATA_DIR=/var/lib/pdf-studio
# Organisation signing certificate (leave unset to use the development certificate):
# PDFSTUDIO_SIGN_P12=/etc/pdf-studio/org-signer.p12
# PDFSTUDIO_SIGN_P12_PASSWORD=...
# PDFSTUDIO_TSA_URL=https://timestamp.example
